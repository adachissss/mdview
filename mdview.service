[Unit]
Description=mdview -- LAN Markdown reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/project/mdview
ExecStart=%h/project/mdview/.venv/bin/python %h/project/mdview/serve.py --port 8899
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
